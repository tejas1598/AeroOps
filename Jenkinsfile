    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out AeroOps source code'
            }
        }

        stage('Build') {
            steps {
                echo 'Building AeroOps application'
            }
        }

        stage('Test') {
            steps {
                echo 'Running AeroOps tests'
            }
        }
    }
}